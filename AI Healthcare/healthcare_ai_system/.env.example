# AI Healthcare Diagnosis API Configuration
# Copy this file to .env and replace with secure values for production.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security Settings
# Generate a strong key using: openssl rand -hex 32
JWT_SECRET_KEY=super_secret_dev_key_never_use_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (Comma separated for multiple, e.g. ["http://localhost:8501", "https://prod.example.com"])
CORS_ORIGINS=["*"]

# Rate Limiting (Dev-friendly)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Max Upload Size
MAX_UPLOAD_SIZE_BYTES=2097152

# Database (MySQL recommended for production, SQLite for local dev/testing)
# DATABASE_URL=mysql+mysqlconnector://root:YOUR_MYSQL_PASSWORD@localhost:3306/ai_healthcare
DATABASE_URL=sqlite:///./healthcare.db

# MySQL credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=ai_healthcare

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=healthcare_user
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=healthcare_db

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0
